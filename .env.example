# Database
DATABASE_URL="postgresql://nexus:nexus_secret@localhost:5433/nexus_platform?schema=public"
# Direct (non-pooled) connection used only by `prisma migrate`/`db push`.
# Same value as DATABASE_URL locally. On Supabase: DATABASE_URL is the pooled
# connection (port 6543, `?pgbouncer=true`), DIRECT_URL is the port-5432 one.
DIRECT_URL="postgresql://nexus:nexus_secret@localhost:5433/nexus_platform?schema=public"

# JWT
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PORT=4000
API_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000,http://localhost:3003"
WEB_URL="http://localhost:3000"

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:4000"

# File storage — 'disk' (default, no extra service) writes uploads locally and
# serves them via a signed URL. Set STORAGE_DRIVER=s3 (+ the S3_* vars below)
# for MinIO/S3, or STORAGE_DRIVER=vercel-blob (+ BLOB_READ_WRITE_TOKEN) when
# running as a Vercel serverless function — local disk isn't writable there.
STORAGE_DRIVER="disk"
UPLOADS_DIR=""                       # defaults to <api>/uploads if blank
API_PUBLIC_URL="http://localhost:4000"  # absolute base the API is reached at (for upload links)
# FILE_URL_SECRET=""                 # optional; falls back to JWT_SECRET for signing upload links

# S3 / MinIO — only used when STORAGE_DRIVER=s3
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="nexus_minio"
# S3_SECRET_KEY="nexus_minio_secret"
# S3_BUCKET="nexus-uploads"
# S3_REGION="us-east-1"

# Vercel Blob — only used when STORAGE_DRIVER=vercel-blob. Auto-populated by
# Vercel once a Blob store is attached to the project; set manually for local
# testing of that driver.
# BLOB_READ_WRITE_TOKEN=""

# Pusher (realtime — POS/inventory/notification live updates). Free tier is
# fine for local dev too, since there's a single Pusher-backed implementation
# (no separate dev-only transport). Create a Channels app at
# https://dashboard.pusher.com to get these.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# OTP (demo mode uses console)
OTP_EXPIRY_MINUTES=10

# Encryption (32-byte hex for Aadhaar etc.)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
