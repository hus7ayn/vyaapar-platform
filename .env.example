# Database
DATABASE_URL="postgresql://nexus:nexus_secret@localhost:5433/nexus_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PORT=4000
API_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000,http://localhost:3003"
WEB_URL="http://localhost:3000"

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="nexus_minio"
S3_SECRET_KEY="nexus_minio_secret"
S3_BUCKET="nexus-uploads"
S3_REGION="us-east-1"
S3_USE_SSL=false

# OTP (demo mode uses console)
OTP_EXPIRY_MINUTES=10

# Encryption (32-byte hex for Aadhaar etc.)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
