{
  "name": "nexus-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Cloud POS + Hotel + ERP SaaS Platform",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @nexus/api dev\" \"pnpm --filter @nexus/web dev\"",
    "build": "pnpm --filter @nexus/api build && pnpm --filter @nexus/web build",
    "db:generate": "pnpm --filter @nexus/api prisma:generate",
    "db:migrate": "pnpm --filter @nexus/api prisma:migrate",
    "db:seed": "pnpm --filter @nexus/api prisma:seed",
    "db:studio": "pnpm --filter @nexus/api prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "deploy:oracle:install": "bash deploy/oracle/install.sh",
    "deploy:oracle:backup": "bash deploy/oracle/backup.sh",
    "desktop:dev": "concurrently -n api,web,desktop -c blue,green,magenta \"pnpm --filter @nexus/api dev\" \"pnpm --filter @nexus/web dev\" \"wait-on http://localhost:3000 http://localhost:4000/api/v1/health && pnpm --filter @nexus/desktop dev\"",
    "desktop:build": "pnpm --filter @nexus/desktop build",
    "desktop:win": "pnpm --filter @nexus/desktop dist:win",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
