# Copy to project root as .env before deploy:
#   cp deploy/oracle/env.template .env
#
# PUBLIC_URL = what users type in the browser (no trailing slash)
# Examples:
#   http://158.101.12.34
#   https://billing.yourshop.com

PUBLIC_URL=http://REPLACE_WITH_YOUR_VM_PUBLIC_IP

# ─── Database (internal Docker network) ───────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=nexus_platform

# ─── Auth (generate: openssl rand -hex 32) ──────────────────────────────────
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS / URLs (match PUBLIC_URL) ─────────────────────────────────────────
CORS_ORIGIN=http://REPLACE_WITH_YOUR_VM_PUBLIC_IP
WEB_URL=http://REPLACE_WITH_YOUR_VM_PUBLIC_IP
API_URL=http://REPLACE_WITH_YOUR_VM_PUBLIC_IP

# ─── File storage ────────────────────────────────────────────────────────────
# 'disk' (default) stores uploads on a persisted Docker volume — no MinIO needed.
# API_PUBLIC_URL is set automatically from PUBLIC_URL in docker-compose.prod.yml.
STORAGE_DRIVER=disk

# ─── Pusher (realtime) — create a free Channels app at https://dashboard.pusher.com
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ─── Misc ───────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
